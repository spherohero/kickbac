# Bash/Git Bash: copy to .env, replace tenant, then export with:
# set -a; . ./.env; set +a
# The application does not auto-load .env. Never commit secret values.
KICKBAC_DB_PATH=data/kickbac.sqlite3
AUTH0_DOMAIN=replace-with-your-tenant.us.auth0.com
# Logical API identifier, NOT a public backend host; exact, no trailing slash.
AUTH0_AUDIENCE=https://kickbac-api
